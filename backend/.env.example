# Tandav Dance Studio Backend configuration
# Copy to .env and adjust for your environment.

DATABASE_URL=postgresql+psycopg2://tandav:tandav_dev_password@127.0.0.1:5433/tandav

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Dev bootstrap admin (only created by `python -m app.seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_FULL_NAME=Studio Admin
SEED_ADMIN_EMAIL=admin@tandav.in

CORS_ORIGINS=["*"]
DEBUG=false