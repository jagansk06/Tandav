# Line endings
# ------------
# The repo was committed with LF but the working tree drifted to CRLF, which
# made 175 untouched files show up as modified and buried the real changes.
# Pinning the normalized (in-repo) form to LF stops that from recurring.
#
# `text=auto` lets git decide which files are text; `eol=lf` then fixes what
# lands in a commit. Windows editors, Flutter, Gradle and PowerShell all handle
# LF fine, so there is no reason to store CRLF.
* text=auto eol=lf

# Windows-only scripts that some tools genuinely expect with CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries — never touch these, and never try to diff them as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
*.pdf  binary
*.apk  binary
*.jks  binary
*.keystore binary
*.so   binary
*.jar  binary
*.bin  binary
*.ser  binary

# Generated / vendored code: keep it out of diff noise and language stats.
mobile/packages/ble_peripheral/** linguist-vendored
*.g.dart   linguist-generated
*.g.kt     linguist-generated
*.g.swift  linguist-generated
*.g.cpp    linguist-generated
